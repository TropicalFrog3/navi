# ==============================================================================
# Jev + Antigravity IDE Fast-Browser Agent Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Jev API Key (ONLY 1 KEY REQUIRED!)
# ------------------------------------------------------------------------------
# Jev is created by TypeSafe AI. You only need this one key.
# (Either JEV_API_KEY or TYPESAFE_API_KEY will work; they are identical aliases)
JEV_API_KEY=your_jev_api_key_here

# Jev API Base URL (default: https://api.typesafe.ai)
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Jev Model Identifier (default: jev-latest)
TYPESAFE_MODEL=jev-latest

# ------------------------------------------------------------------------------
# 2. Antigravity IDE (NO API KEY NEEDED)
# ------------------------------------------------------------------------------
# Uses your active Antigravity IDE Google account session automatically.
# Set to true if you want to bypass Antigravity and run 100% on Jev alone.
JEV_ONLY=false

# ------------------------------------------------------------------------------
# 3. Browser & Automation Configuration
# ------------------------------------------------------------------------------
# Run browser in headless mode (true/false)
BROWSER_HEADLESS=false

# Slow motion delay in milliseconds between Playwright actions (0 for maximum speed)
BROWSER_SLOW_MO=50

# Default viewport dimensions
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800

# ------------------------------------------------------------------------------
# 4. Decision Engine Parameters
# ------------------------------------------------------------------------------
# Confidence threshold to execute Jev action deterministically (>= 0.7)
CONFIDENCE_THRESHOLD=0.7

# Memory constraint: maximum number of actions stored in sliding window (default: 5)
SLIDING_WINDOW_SIZE=5

# Maximum navigation/action steps per run before aborting
MAX_STEPS=30

# Cookie banner auto-dismiss safeguard enabled (true/false)
AUTO_DISMISS_COOKIE_BANNERS=true

# ------------------------------------------------------------------------------
# 5. Offline / Mock Testing Mode
# ------------------------------------------------------------------------------
# Set to true to run deterministic simulations without calling live API keys
MOCK_MODE=false
