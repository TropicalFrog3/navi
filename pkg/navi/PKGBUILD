# Maintainer: Ace! _SL/S <acesls@protonmail.com>
pkgname="navi"
pkgver=20260819131545
pkgrel=1
pkgdesc="Steamclient Mod"
arch=("i686" "x86_64")
url="https://github.com/AceSLS/navi"
license=("AGPL-3.0-only")

depends=("steam"
		"lib32-openssl"
		"lib32-glibc"
		"lib32-gcc-libs")

optdepends=("steam-native"
			"ccache: Speeds up compilation"
			"dotnet-runtime-9.0: navi-ticket-generator")

provides=("navi")
conflicts=("navi-git")

source=("https://github.com/AceSLS/navi/archive/refs/tags/$pkgver.tar.gz")
makedepends=("gcc"
			"dotnet-sdk-9.0")

#Disable stripping to not mess up disturb ticket-grabber
options=(!strip)

sha256sums=('342d8d01e134481a8878dcd21c557d90758c79e4f555a4828cc68dd3cbc5b201')
validpgpkeys=("63AB8F4BF8A62EEEB8D8C7584410F8CF7129B2D6")

build() {
	cd "$srcdir/navi-$pkgver"
	make build
}

package() {
	cd "$pkgdir"

	install -D "$srcdir/navi-$pkgver/bin/libnavi.so" "$pkgdir/usr/lib32/libnavi.so"
	install -D "$srcdir/navi-$pkgver/bin/library-inject.so" "$pkgdir/usr/lib32/libnavi-library-inject.so"
	install -D "$srcdir/navi-$pkgver/res/navi.desktop" "$pkgdir/usr/share/applications/navi.desktop"
	install -D "$srcdir/navi-$pkgver/res/navi-native.desktop" "$pkgdir/usr/share/applications/navi-native.desktop"
	install -D "$srcdir/navi-$pkgver/res/logo.png" "$pkgdir/usr/share/pixmaps/navi.png"

	#Disabled until dev reaches main
	install -D "$srcdir/navi-$pkgver/tools/ticket-grabber/bin/Release/net9.0/linux-x64/publish/ticket-grabber" "$pkgdir/usr/bin/navi-ticket-grabber"
	install -D "$srcdir/navi-$pkgver/tools/schema-grabber/bin/Release/net9.0/linux-x64/publish/schema-grabber" "$pkgdir/usr/bin/navi-schema-grabber"
}
